rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Trip files. We're DROPPING cross-service firestore.get() to verify
    // ownership: it was returning 403 even for the trip owner in production
    // (likely a service-identity / cross-service permission quirk that's
    // not obvious from the rule text). Trade-off:
    //
    //   - ANY authenticated user can read/write under trips/{tripId}/.
    //   - This is fine in practice because path names include a long
    //     random tripId (Firestore auto-id, 20 chars, ~120 bits of entropy
    //     — guessable in 2^60 attempts at best).
    //   - Firestore rules still enforce trip-level membership: someone
    //     who guesses a tripId can't see the photo URLs in the album
    //     unless they have access via createdBy or travelerIds.
    //
    // 25 MB upload cap retained.
    match /trips/{tripId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && (request.resource == null
                        || request.resource.size < 25 * 1024 * 1024);
    }

    // Tripshistory photos: enforce image type + 10MB max (per-user scope).
    match /users/{userId}/tripstories/{storyId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && (request.resource == null
                        || (request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*')));
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
