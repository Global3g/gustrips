rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // TEMP DIAGNOSTIC: trip photos/documents readable + writable by any
    // signed-in user. If uploads work now, we've confirmed the issue is
    // with the cross-service firestore.get() in the ownership check
    // and we can restore a working strict rule using a different pattern.
    // Single-user environment so this is briefly safe. Will be reverted.
    match /trips/{tripId}/{allPaths=**} {
      allow read, write: if request.auth != null
                          && (request.resource == null
                              || request.resource.size < 25 * 1024 * 1024);
    }

    // Tripshistory photos: enforce image type + 10MB max (unchanged)
    match /users/{userId}/tripstories/{storyId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && (request.resource == null
                        || (request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*')));
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
