rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Trips: split allow statements per access path so the rule analyzer
    // can match each clean condition against the query.
    match /trips/{tripId} {
      // 1) Owner reads their own trip.
      allow read: if isSignedIn()
                   && resource.data.createdBy == request.auth.uid;

      // 2) Invited traveler.
      allow read: if isSignedIn()
                   && request.auth.uid in resource.data.get('travelerIds', []);

      // 3) Public share-link viewer.
      allow read: if resource.data.shareToken is string
                   && resource.data.shareToken.size() > 0;

      allow create: if isSignedIn()
                     && request.resource.data.createdBy == request.auth.uid;

      allow update: if isSignedIn()
                     && resource.data.createdBy == request.auth.uid
                     && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isSignedIn()
                     && resource.data.createdBy == request.auth.uid;

      // Subcollections (members, events, documents, checklist, photos).
      // Inline get() — no helper function — because helper-style had been
      // unreliable across rule paths. Each allow is a single condition.
      match /{subcollection}/{docId} {
        allow read: if isSignedIn()
                     && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid;
        allow read: if isSignedIn()
                     && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.get('travelerIds', []);
        allow read: if get(/databases/$(database)/documents/trips/$(tripId)).data.shareToken is string
                     && get(/databases/$(database)/documents/trips/$(tripId)).data.shareToken.size() > 0;

        allow write: if isSignedIn()
                      && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid;
        allow write: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.get('travelerIds', []);

        // Deep subcollections (e.g. trips/{id}/photos/{id}/comments).
        match /{deep=**} {
          allow read: if isSignedIn()
                       && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid;
          allow read: if isSignedIn()
                       && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.get('travelerIds', []);
          allow read: if get(/databases/$(database)/documents/trips/$(tripId)).data.shareToken is string
                       && get(/databases/$(database)/documents/trips/$(tripId)).data.shareToken.size() > 0;

          allow write: if isSignedIn()
                        && get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid;
          allow write: if isSignedIn()
                        && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.get('travelerIds', []);
        }
      }
    }

    // Push subscriptions: per-user, scoped by userId field.
    match /pushSubscriptions/{subId} {
      allow read, delete: if isSignedIn()
                           && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                     && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                     && resource.data.userId == request.auth.uid
                     && request.resource.data.userId == resource.data.userId;
    }

    // Global travelers per user
    match /users/{userId}/travelers/{travelerId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Tripshistory: trip stories per user (with subcollections: photos, questions, days, events)
    match /users/{userId}/tripstories/{storyId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/tripstories/{storyId}/{subcollection=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

  }
}
