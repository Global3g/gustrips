rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function tripData(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }

    function hasValidShareToken(t) {
      return t.shareToken is string && t.shareToken.size() > 0;
    }

    // Trips: members can read + write their trips. Trips with shareToken
    // are publicly readable for the share view.
    //
    // The read permission is split into THREE separate `allow read`
    // statements (one per access path) instead of one big OR'd condition.
    // Firestore's static analyzer can match each clean condition against
    // the corresponding query structure (where-clause, etc.) — it can NOT
    // reliably match an `array-contains` query against an `in ... is list`
    // clause buried inside an OR with other predicates. Symptom of the
    // monolithic rule: "Missing or insufficient permissions" on a query
    // that should obviously be allowed.
    match /trips/{tripId} {
      // 1) Owner reads their own trip.
      allow read: if isSignedIn()
                   && resource.data.createdBy == request.auth.uid;

      // 2) Invited traveler reads a trip they're listed on. Using
      //    `.get('travelerIds', [])` so missing field doesn't throw —
      //    `in []` is always false, which is what we want.
      allow read: if isSignedIn()
                   && request.auth.uid in resource.data.get('travelerIds', []);

      // 3) Anyone with a valid shareToken can read (the /shared/[token]
      //    public view). Query must filter by `where('shareToken','==',t)`.
      allow read: if hasValidShareToken(resource.data);

      allow create: if isSignedIn()
                     && request.resource.data.createdBy == request.auth.uid;

      allow update: if isSignedIn()
                     && resource.data.createdBy == request.auth.uid
                     // owner cannot be reassigned via update
                     && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isSignedIn()
                     && resource.data.createdBy == request.auth.uid;

      // Subcollections (members, events, documents, checklist, photos).
      // Read paths split per the same reasoning above.
      match /{subcollection}/{docId} {
        allow read: if isSignedIn()
                     && tripData(tripId).createdBy == request.auth.uid;
        allow read: if isSignedIn()
                     && request.auth.uid in tripData(tripId).get('travelerIds', []);
        allow read: if hasValidShareToken(tripData(tripId));

        allow write: if isSignedIn()
                      && tripData(tripId).createdBy == request.auth.uid;
        allow write: if isSignedIn()
                      && request.auth.uid in tripData(tripId).get('travelerIds', []);

        // Deep subcollections (e.g. trips/{id}/photos/{id}/comments).
        match /{deep=**} {
          allow read: if isSignedIn()
                       && tripData(tripId).createdBy == request.auth.uid;
          allow read: if isSignedIn()
                       && request.auth.uid in tripData(tripId).get('travelerIds', []);
          allow read: if hasValidShareToken(tripData(tripId));

          allow write: if isSignedIn()
                        && tripData(tripId).createdBy == request.auth.uid;
          allow write: if isSignedIn()
                        && request.auth.uid in tripData(tripId).get('travelerIds', []);
        }
      }
    }

    // Push subscriptions: per-user, scoped by userId field.
    match /pushSubscriptions/{subId} {
      allow read, delete: if isSignedIn()
                           && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
                     && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                     && resource.data.userId == request.auth.uid
                     && request.resource.data.userId == resource.data.userId;
    }

    // Global travelers per user
    match /users/{userId}/travelers/{travelerId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Tripshistory: trip stories per user (with subcollections: photos, questions, days, events)
    match /users/{userId}/tripstories/{storyId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/tripstories/{storyId}/{subcollection=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

  }
}
