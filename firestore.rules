rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Trips: cualquier usuario autenticado puede leer todos los viajes
    // Trips con shareToken pueden ser leidos sin autenticacion
    // Pero solo puede escribir sus propios viajes
    match /trips/{tripId} {
      allow read: if request.auth != null
                   || (resource.data.shareToken != null && resource.data.shareToken != '');
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;

      // Subcolecciones (members, events, documents, checklist)
      // Lectura publica si el viaje padre tiene shareToken
      match /{subcollection}/{docId} {
        allow read: if request.auth != null
                     || (get(/databases/$(database)/documents/trips/$(tripId)).data.shareToken != null
                         && get(/databases/$(database)/documents/trips/$(tripId)).data.shareToken != '');
        allow write: if request.auth != null;
      }
    }

    // Global travelers per user
    match /users/{userId}/travelers/{travelerId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tripshistory: trip stories per user (with subcollections: photos, questions, days, events)
    match /users/{userId}/tripstories/{storyId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/tripstories/{storyId}/{subcollection=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
